.env
# Nothing under data/ is ever committed (biometric/HR data is PII).
# The folder travels with the repo only as an empty placeholder.
data/*
!data/.gitkeep
# HR leave reports contain PII — never commit (leave-ingestion spec §0).
*.xls
*.xlsx
data/.leave_uploads/
__pycache__/
*.pyc
frontend/node_modules/
frontend/dist/
