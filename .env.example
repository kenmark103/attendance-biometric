# Copy to .env and fill in. Never commit the real .env.

# Shared secret used to sign/verify session tokens between auth-service and api.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# Flip to true once you've confirmed the auth-service flow works end to end.
AUTH_REQUIRED=false

FRONTEND_URL=http://localhost:3001

# --- Google (for you to learn/test the OAuth flow — not for production) ---
# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register there:
#   http://localhost:8002/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Entra ID (Technobrain tenant — fill in once IT/senior dev provisions
#     the App Registration; leaving these blank just disables the route,
#     nothing else breaks) ---
# Redirect URI to register in the App Registration:
#   http://localhost:8002/auth/callback/entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- How to disable Google once Entra is live ---
# 1) Clear GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET in .env (leave blank)
#    -> auth-service automatically drops 'google' from /auth/providers
#    -> frontend hides the Google button (AuthHeader.jsx checks providers)
# 2) Optional code cleanup (no functional need):
#    - Remove the Google OAuth block in auth-service/app/main.py:37-44
#    - Remove the 'google' branch in frontend/src/components/AuthHeader.jsx
#    - Remove Google redirect URI from Google Cloud console
# No DB change needed.

# --- COSEC biometric ingestion (api/app/ingestion) ---
# Base URL of the on-prem COSEC API (plain HTTP on the device network).
COSEC_BASE_URL=http://192.168.1.240/COSEC/api.svc/v2
COSEC_USER=
COSEC_PASSWORD=
COSEC_TIMEOUT_SECONDS=60
COSEC_MAX_RANGE_DAYS=31
POLL_INTERVAL_SECONDS=300
POLL_LOOKBACK_DAYS=3
MAX_PLAUSIBLE_SPAN_MIN=960
MAX_MALFORMED_RATIO=0.05
