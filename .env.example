# Copy to .env and fill in. Never commit the real .env.

# HS256 signing secret for our own JWTs (both login methods end here —
# downstream code never sees Entra tokens). 32+ chars; the API refuses to
# start without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# "true" (default) enforces login on every endpoint except /health and
# /auth/*. Set "false" for open local dev without tokens.
AUTH_REQUIRED=true

ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
REFRESH_ABSOLUTE_DAYS=30
COOKIE_SECURE=false         # true everywhere except local http

FRONTEND_URL=http://localhost:3001

# --- Entra ID (Technobrain tenant — fill in once IT/senior dev provisions
#     the App Registration; blank just disables SSO with 503,
#     email/password keeps working) ---
# Redirect URI to register in the App Registration:
#   http://localhost:8001/auth/microsoft/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8001/auth/microsoft/callback

# --- Bootstrap admin (break-glass + first login before any users exist).
# Seeded once at startup if no active local admin exists. 12+ chars.
# Must NOT be a real Entra email (SSO never merges into local accounts).
BOOTSTRAP_ADMIN_EMAIL=admin@attendance.internal
BOOTSTRAP_ADMIN_PASSWORD=

# --- COSEC biometric ingestion (api/app/ingestion) ---
# Base URL of the on-prem COSEC API (plain HTTP on the device network).
COSEC_BASE_URL=http://192.168.1.240/COSEC/api.svc/v2
COSEC_USER=
COSEC_PASSWORD=
COSEC_TIMEOUT_SECONDS=60
COSEC_MAX_RANGE_DAYS=31
POLL_INTERVAL_SECONDS=300
POLL_LOOKBACK_DAYS=3
MAX_PLAUSIBLE_SPAN_MIN=960
MAX_MALFORMED_RATIO=0.05
