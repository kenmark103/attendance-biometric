# Copy to .env and fill in. Never commit the real .env.

# HS256 signing secret for our own JWTs (both login methods end here —
# downstream code never sees Entra tokens). 32+ chars; the API refuses to
# start without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# "true" (default) enforces login on every endpoint except /health and
# /auth/*. Set "false" for open local dev without tokens.
AUTH_REQUIRED=true

APP_ENV=dev
PUBLIC_API_BASE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
JWT_ALGORITHM=HS256
JWT_ISSUER=attendance-app
JWT_AUDIENCE=attendance-app-web
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_ABSOLUTE_TTL_DAYS=30
REFRESH_IDLE_TTL_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10
IDLE_LOGOUT_MINUTES=60
IDLE_WARNING_SECONDS=60
REFRESH_COOKIE_NAME=att_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Entra ID (Technobrain tenant — fill in once IT/senior dev provisions
#     the App Registration; blank just disables SSO with 503,
#     email/password keeps working) ---
# Redirect URI to register in the App Registration:
#   http://localhost:8001/api/auth/entra/callback
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8001/api/auth/entra/callback
ENTRA_ROLE_SOURCE=roles
ENTRA_ROLE_ADMIN=Admin
ENTRA_ROLE_VIEWER=Viewer
ENTRA_GROUP_ADMIN_ID=
ENTRA_GROUP_VIEWER_ID=
ENTRA_ALLOWED_EMAIL_DOMAINS=
ENTRA_CLOCK_SKEW_SECONDS=60
ENTRA_PROMPT=select_account
ENTRA_REAUTH_DAYS=7

# --- Bootstrap admin (break-glass + first login before any users exist).
# Seeded once at startup if no active local admin exists. 12+ chars.
# Must NOT be a real Entra email (SSO never merges into local accounts).
BOOTSTRAP_ADMIN_EMAIL=admin@attendance.internal
BOOTSTRAP_ADMIN_PASSWORD=
LOCAL_AUTH_ENABLED=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Work from home ---
WFH_EXCLUSION_ENABLED=false
SUPPORT_CONTACT_TEXT=

# --- COSEC biometric ingestion (api/app/ingestion) ---
# Base URL of the on-prem COSEC API (plain HTTP on the device network).
COSEC_BASE_URL=http://192.168.1.240/COSEC/api.svc/v2
COSEC_USER=
COSEC_PASSWORD=
COSEC_TIMEOUT_SECONDS=60
COSEC_MAX_RANGE_DAYS=31
POLL_INTERVAL_SECONDS=300
POLL_LOOKBACK_DAYS=3
MAX_PLAUSIBLE_SPAN_MIN=960
MAX_MALFORMED_RATIO=0.05

# --- Leave ingestion: manual Zoho report upload (api/app/leave) ---
# EXPECTED_DEPARTMENT_LABELS is ';'-separated (the label itself has a comma).
EXPECTED_DEPARTMENT_LABELS=GBS- ENGINEERING CENTRE,Engineering Centre
# Zoho P with no punch counts as present (remote/manual sign-in). When false,
# such days are absent (if biometrically covered) or absent_unverified.
TRUST_ZOHO_PRESENCE=true
# Source priority when xls and api rows exist for the same day.
LEAVE_SOURCE_PRIORITY=api,xls
# Roles that see leave-type detail (sick/maternity/paternity); others see 'On leave'.
LEAVE_TYPE_DETAIL_ROLES=admin
# Minimum punch evidence; default 0 = any punch counts as present.
MIN_PUNCH_MINUTES=0
# Upload cap for the HR workbook.
LEAVE_UPLOAD_MAX_MB=10
